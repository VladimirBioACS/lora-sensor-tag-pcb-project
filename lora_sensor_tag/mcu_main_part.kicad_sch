	(text "External capacitors calculation:\nCL = (C1 * C2) / (C1 + C2) + Cstray\n\nCL - load capacitance (from datasheet - 9pF)\nCstray - parasitic capacitance (from 3pF to 5pF)\n\nCL - Cstray = 9pF - 4pF = 5pF\n\nLet's assume that C21 and C22 are equal:\nC21 = C22 = 2 * (CL - Cstray) = 2 * 5 = 10pF\n\nReal range:\nfrom 10pF to 12pF\n\nPierce oscillator \n(physics of the oscillator and capacitor connections)\n\nResource\nhttps://support.microchip.com/s/article/Calculating-crystal-load-capacitor"
		(exclude_from_sim no)
		(at 116.078 112.776 0)
		(effects
			(font
				(size 0.635 0.635)
			)
			(justify left)
		)
		(uuid "1f0cd07b-e3e4-46d8-a4a3-d2e58e6f4815")
	)
